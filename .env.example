# Copy this file to .env for local development.
# Never commit the real API key.
SHLIB_API_KEY=replace_with_your_shanghai_library_api_key

# Optional: set to 1 to prefer live API ingestion.
# STABLETRADE_USE_LIVE_API is still supported for compatibility.
CONTEXTLENS_USE_LIVE_API=0

# Optional DeepSeek fast-assist layer. Keep the real key only in .env.
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
# STABLETRADE_USE_DEEPSEEK is still supported for compatibility.
CONTEXTLENS_USE_DEEPSEEK=1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=10
DEEPSEEK_MAX_TOKENS=620
